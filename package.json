{
  "name": "better-spotify",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "bun --bun ./server.ts",
    "test": "bun test --max-concurrency 4 --timeout 60000",
    "lint": "oxlint app server.ts serverRequest.ts serverRequest.test.ts --deny-warnings",
    "typecheck": "react-router typegen && tsc --noEmit --incremental false",
    "check": "bun run test && bun run lint && bun run typecheck && bun run build",
    "clean": "rm -rf build && rm -rf public/build",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.52",
    "@electric-sql/pglite": "^0.5.8",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "ai": "^7.0.85",
    "arctic": "^3.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.2.2",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  }
}
